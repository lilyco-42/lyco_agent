{
  "domain": "rust-cli-demo",
  "version": 1,
  "rules": [
    {
      "left": ["创建", "新建", "建立", "create", "new"],
      "right": ["项目", "project", "工程"],
      "intent": "rust.project.create"
    },
    {
      "left": ["初始化", "init"],
      "right": ["项目", "project", "工程"],
      "intent": "rust.project.create"
    },
    {
      "left": ["运行", "跑", "run"],
      "right": ["项目", "project", "程序"],
      "intent": "rust.project.run"
    },
    {
      "left": ["进入", "chdir", "cd"],
      "right": [],
      "intent": "fs.chdir"
    }
  ]
}
